{
  "name": "@yceffort/number-flow-react",
  "version": "0.1.0",
  "description": "React wrapper for @yceffort/number-flow. Drop-in compatible fork of @number-flow/react with extended browser support.",
  "author": {
    "name": "yceffort",
    "url": "https://yceffort.kr"
  },
  "license": "MIT",
  "homepage": "https://github.com/yceffort/number-flow",
  "repository": {
    "type": "git",
    "url": "https://github.com/yceffort/number-flow",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/yceffort/number-flow/issues"
  },
  "keywords": [
    "accessible",
    "odometer",
    "animation",
    "number-format",
    "number-animation",
    "animated-number",
    "number-flow",
    "react"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "echo 'covered by e2e'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yceffort/number-flow": "workspace:*",
    "esm-env": "^1.1.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
